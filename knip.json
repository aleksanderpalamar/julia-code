{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["juju.ts"],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
  "ignore": ["dist/**", "data/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [],
  "rules": {
    "exports": "error",
    "types": "error",
    "files": "error"
  },
  "tags": ["+__knip-keep"]
}
